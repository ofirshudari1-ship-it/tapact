{
  "manifest_version": 3,
  "name": "TapAct – Copy to WhatsApp",
  "short_name": "TapAct",
  "version": "1.3.0",
  "description": "Copy a phone number anywhere, then open a WhatsApp chat with a ready-made message in one click.",
  "icons": {
    "16": "icons/icon16.png",
    "32": "icons/icon32.png",
    "48": "icons/icon48.png",
    "128": "icons/icon128.png"
  },
  "action": {
    "default_popup": "popup.html",
    "default_icon": {
      "16": "icons/icon16.png",
      "32": "icons/icon32.png",
      "48": "icons/icon48.png",
      "128": "icons/icon128.png"
    },
    "default_title": "TapAct – open WhatsApp with the copied number"
  },
  "options_page": "options.html",
  "commands": {
    "_execute_action": {
      "suggested_key": { "default": "Alt+Shift+P" },
      "description": "Open TapAct with the copied number"
    }
  },
  "permissions": ["storage", "clipboardRead"],
  "content_security_policy": {
    "extension_pages": "script-src 'self'; object-src 'self'"
  }
}
